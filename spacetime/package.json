{
  "name": "moove-spacetime",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "spacetime build -p .",
    "start:local": "spacetime start",
    "publish:local": "spacetime publish -s local -p . --yes=skip-login,all moove",
    "publish:local:reset": "spacetime publish -s local -p . --delete-data --yes=all moove",
    "publish:cloud": "spacetime publish -s maincloud -p . moove",
    "generate": "spacetime generate --lang typescript --out-dir ../agents/src/module_bindings -p . -y"
  },
  "dependencies": {
    "spacetimedb": "^2.13.0",
    "typescript": "^5.9.3"
  }
}
