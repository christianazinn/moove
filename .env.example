# Copy to .env.local (gitignored). Never commit real values.
# --- SpacetimeDB ---
# Shared DB on maincloud. Use ws://localhost:3000 against a local `spacetime start`.
SPACETIME_URI=wss://maincloud.spacetimedb.com
SPACETIME_DB_NAME=moove
# Worker identity token (file is written automatically; keep one file per server)
SPACETIME_WORKER_TOKEN_FILE=.worker-token
# --- Anthropic ---
ANTHROPIC_API_KEY=
MODEL_VISION=claude-sonnet-5-5
MODEL_FAST=claude-haiku-5-5
MODEL_AGENT=claude-opus-5-5
# --- Apify ---
APIFY_TOKEN=
# Comps sources (ebay,fb,craigslist), cost cap per actor run, and market cities
APIFY_SOURCES=ebay,fb
APIFY_MAX_USD_PER_RUN=0.10
MARKET_CITY_FB=sanfrancisco
MARKET_CITY_CRAIGSLIST=sfbay
# --- Coinbase CDP / x402 (Base Sepolia) ---
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
CDP_WALLET_SECRET=
X402_NETWORK=base-sepolia
AGENT_SPEND_CAP_USDC=5
# Max a single x402 call may cost (USDC). Bigger quotes are refused and logged.
X402_MAX_PER_CALL_USDC=0.10
# Optional comma-separated payTo allowlist for x402 payments (empty = any address, still capped)
X402_ALLOWED_PAYEES=
# 1 (default) = count the last 24h of x402 payment rows against each agent's budget at startup, so a
# restart can't reset it. 0 = start every agent at zero (e.g. after rehearsals).
X402_SEED_BUDGETS=1
# 1 = force the simulated rail (payments labeled simulated). Unset + CDP keys = real Base Sepolia payments.
X402_SIMULATE=
# Port for the worker's paywalled comps endpoint (bound to 127.0.0.1)
X402_PORT=8402
# 1 (default) = the pricing agent buys its comps over x402; 0 = calls Apify directly
PRICING_PAY_X402=1
# --- eBay sandbox ---
# Real sandbox posting turns on when ALL of these are set (#32); otherwise listings are simulated.
# Get them with `npm run ebay:setup -- consent | token | provision | check` in agents/.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_RUNAME=
EBAY_REFRESH_TOKEN=
EBAY_FULFILLMENT_POLICY_ID=
EBAY_PAYMENT_POLICY_ID=
EBAY_RETURN_POLICY_ID=
EBAY_LOCATION_KEY=moove-sf
EBAY_ENV=sandbox
EBAY_MARKETPLACE_ID=EBAY_US
# eBay needs public https photos. Use an https PUBLIC_UPLOAD_BASE_URL (tunnel), or this placeholder.
EBAY_FALLBACK_IMAGE_URL=
# Listings are simulated for the demo (#11). >0 flips posted listings to sold after N seconds.
LISTING_SIM_SOLD_AFTER_SEC=0
# --- Visa checkout (#15) ---
# acceptance = Visa Acceptance (CyberSource) REST sandbox, test card, no real money
# simulated  = no network, rows say simulated: true (default when the keys below are missing)
# vic        = Visa Intelligent Commerce, not implemented (credentials are gated); falls back to simulated
VISA_PROVIDER=
# Sandbox Business Center > Payment Configuration > Key Management > REST - Shared Secret
VISA_ACCEPTANCE_MERCHANT_ID=
VISA_ACCEPTANCE_KEY_ID=
VISA_ACCEPTANCE_SECRET=
# Sandbox only; any other host is refused
VISA_ACCEPTANCE_HOST=apitest.cybersource.com
# Buy-agent card guardrails (USD), on top of each user's approval threshold
VISA_SPEND_CAP_USD=1500
VISA_MAX_PER_PURCHASE_USD=750
# Simulated checkout step delay, for a readable live demo
VISA_SIM_DELAY_MS=400
# Buy agent: 0 (default) = rank + recommend, nothing is bought until the user chooses a deal in the app;
# 1 = also choose the recommendation (buys at/under the approval threshold happen on their own).
# BUY_FRAUD_BLOCK: fraud score (#18) at/above which it won't buy
BUY_AUTO_CHOOSE=0
BUY_FRAUD_BLOCK=0.7
# 1 = wait for the fraud screen (#18) to score a deal before buying it (off until a fraud agent runs)
BUY_REQUIRE_FRAUD_SCORE=0
# Deal search for the buy agent: apify | fixtures (defaults to apify when APIFY_TOKEN is set).
# Reuses APIFY_TOKEN, APIFY_MAX_USD_PER_RUN, MARKET_CITY_FB and MARKET_CITY_CRAIGSLIST from pricing (#6).
DEALS_SOURCE=
DEALS_APIFY_SOURCES=fb,craigslist,ebay
DEALS_PER_SOURCE=6
# New home's coordinates, for pickup distance (optional)
DEALS_HOME_LAT=
DEALS_HOME_LNG=
# --- Auth0 ---
# Tenant dev-78lq8spq27b2bipk.us.auth0.com. The iOS app uses the public Native app
# "Moove iOS" (client id in ios/Config/Moove.xcconfig). The worker needs its own
# confidential app for CIBA approvals (#12); put that one's id/secret below.
AUTH0_DOMAIN=dev-78lq8spq27b2bipk.us.auth0.com
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_AUDIENCE=
# Worker's own confidential Auth0 app (Regular Web App with the CIBA grant) for phone approvals (#12).
# Distinct from AUTH0_CLIENT_ID/SECRET (the iOS app). Leave empty to use only the in-app approvals inbox.
AUTH0_CIBA_CLIENT_ID=
AUTH0_CIBA_CLIENT_SECRET=
# Threshold used when the owner has no user row (users' own setting wins). -1 = always ask.
APPROVAL_THRESHOLD_CENTS_DEFAULT=10000
# DEMO ONLY, labeled simulated: >0 auto-approves pending approvals after N seconds when Auth0 is NOT configured. Keep 0.
APPROVAL_SIM_AUTO_APPROVE_SEC=0
# --- Worker ---
UPLOAD_PORT=8787
PUBLIC_UPLOAD_BASE_URL=http://localhost:8787
UPLOAD_DIR=uploads
# Largest accepted upload in bytes (default 50 MB)
UPLOAD_MAX_BYTES=52428800
